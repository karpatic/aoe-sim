{
  "name": "aoe-sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:scenario": "node tools/build-scenario.mjs",
    "build:ruleset": "/tmp/aoe-genie-env/bin/python tools/build-ruleset.py",
    "build:dataview-reconstruction-runtime": "node tools/build-dataview-reconstruction-runtime.mjs",
    "prepare:dataview-runtime": "node tools/prepare-dataview-runtime.mjs",
    "build:docs-manifest": "node tools/write-docs-manifest.mjs",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dataview:diagnostics": "node --experimental-strip-types tools/dataview-diagnostics.mjs",
    "check:dataview-reconstruction": "node --experimental-strip-types tools/dataview-diagnostics.mjs --check --out /tmp/aoe-sim-dataview-diagnostics.json && python3 tools/validate-dataview-diagnostics.py /tmp/aoe-sim-dataview-diagnostics.json",
    "build": "npm run build:dataview-reconstruction-runtime && npm run prepare:dataview-runtime && tsc -p tsconfig.json --noEmit && vite build && npm run build:docs-manifest",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "dependencies": {
    "aoe2rec-js": "0.1.22",
    "pyodide": "0.28.3"
  }
}
